# Smart Farm environment variables. Copy to .env for local runs outside Docker
# (`cp .env.example .env`). Never commit a real .env. In staging/production set these in the
# host's secrets manager. Lines marked [required] have no default.

# --- Django ---------------------------------------------------------------------------------
APP_ENV=development                      # development | test | staging | production
DJANGO_SETTINGS_MODULE=config.settings.dev  # config.settings.prod in staging/production
DJANGO_SECRET_KEY=change-me              # [required] long random string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1 # [required in prod] comma-separated
DJANGO_ADMIN_URL=admin/                  # move the admin off the default path in production
SECURE_SSL_REDIRECT=true                 # prod only; false if TLS ends before Django and no proxy header
CORS_ALLOWED_ORIGINS=http://localhost:5180
CSRF_TRUSTED_ORIGINS=http://localhost:5180
FRONTEND_URL=http://localhost:5180       # used in email links

# --- Database -------------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smartfarm  # 5433 if you use the compose database  # [required]
DATABASE_CONN_MAX_AGE=60

# --- Redis / Celery / Channels ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=                       # defaults to REDIS_URL
CELERY_RESULT_BACKEND=                   # defaults to REDIS_URL
CHANNELS_REDIS_URL=                      # defaults to REDIS_URL
CACHE_REDIS_URL=                         # defaults to REDIS_URL
CELERY_TASK_ALWAYS_EAGER=false

# --- JWT ------------------------------------------------------------------------------------
JWT_ALGORITHM=HS256                      # RS256 in production with the two keys below
JWT_SIGNING_KEY=                         # defaults to DJANGO_SECRET_KEY for HS256; PEM private key for RS256
JWT_VERIFYING_KEY=                       # PEM public key for RS256

# --- Files: S3-compatible storage (AWS S3, DigitalOcean Spaces, MinIO) ------------------------
USE_S3=false
S3_ENDPOINT_URL=http://localhost:9000    # empty for AWS S3
S3_REGION=us-east-1
S3_BUCKET=smartfarm
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_DOMAIN=                        # optional CDN / custom domain

# --- Email ----------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost                     # Mailpit locally (UI at http://localhost:8025)
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=                     # SendGrid / Mailgun / SES SMTP credentials in production
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=Smart Farm <no-reply@smartfarm.local>

# --- Messaging (phase 6) ----------------------------------------------------------------------
MESSAGING_ADAPTER=console                # console everywhere except staging and production
WHATSAPP_ACCESS_TOKEN=                   # Meta WhatsApp Cloud API system-user token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=                     # verifies webhook signatures
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=SMARTFARM

# --- Logging and monitoring --------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json                          # json | text (dev settings default to text)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Docker Compose host ports (defaults avoid clashing with other local projects) ----------
WEB_PORT=5180
API_PORT=8010
WS_PORT=8011
DB_PORT=5433
REDIS_PORT=6380
MAILPIT_PORT=8026
MAILPIT_SMTP_PORT=1026
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011

# --- Frontend (build time, read by Vite) --------------------------------------------------------
VITE_PORT=5180
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://localhost:8010      # dev server proxy for /api
VITE_WS_PROXY_TARGET=http://localhost:8011   # dev server proxy for /ws
