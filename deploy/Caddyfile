# HTTPS front door: certificates from Let's Encrypt, then route by path.
{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		-Server
	}

	handle /ws/* {
		reverse_proxy websocket:8001
	}
	# Uploaded files kept on the server (when not using S3).
	handle /media/* {
		root * /srv
		file_server
	}
	@backend path /api/* /admin/* /static/*
	handle @backend {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:80
	}
}
